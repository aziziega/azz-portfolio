# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (azz-portfolio & Headless CMS)
# ==============================================================================
# Petunjuk: 
# 1. Salin file ini menjadi `.env.local` di direktori root:
#    cp .env.example .env.local
# 2. Isi nilai variabel di bawah ini dengan kredensial project Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Wajib)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. SITE & ADMIN CMS ACCESS CONFIGURATION
# ------------------------------------------------------------------------------
# URL domain website Anda (Gunakan http://localhost:3000 untuk mode lokal)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Username admin untuk display/login
ADMIN_LOGIN_USERNAME=admin

# Email admin yang diizinkan mengakses panel CMS /admin (Harus cocok dengan email Supabase Auth)
ADMIN_ALLOWED_EMAIL=your-admin-email@example.com

# ------------------------------------------------------------------------------
# 3. RESEND EMAIL SERVICE (Kontak, Notifikasi, & Newsletter)
# ------------------------------------------------------------------------------
# Dapatkan API Key di https://resend.com/api-keys
RESEND_API=re_your_resend_api_key

# Sender email dengan domain yang sudah diverifikasi di Resend
# (Contoh: "Your Name <newsletter@yourdomain.com>" atau "onboarding@resend.dev" untuk testing)
RESEND_FROM_EMAIL="Your Name <newsletter@yourdomain.com>"

# ------------------------------------------------------------------------------
# 4. CLIENT FEEDBACK PORTAL (Token Rahasia Formulir Klien)
# ------------------------------------------------------------------------------
# Token rahasia untuk memproteksi halaman ulasan klien (/feedback?token=...)
# Buat string acak unik yang aman
FEEDBACK_TOKEN=your-random-secret-feedback-token-here
NEXT_PUBLIC_FEEDBACK_TOKEN=your-random-secret-feedback-token-here
